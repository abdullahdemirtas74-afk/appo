{
	"appId": "com.appo.app",
	"appName": "AppO",
	"webDir": "www",
	"server": {
		"url": "https://appo-ad.com",
		"cleartext": false,
		"androidScheme": "https",
		"allowNavigation": [
			"appo-ad.com",
			"www.appo-ad.com",
			"appo-production-10fb.up.railway.app",
			"*.up.railway.app",
			"localhost",
			"127.0.0.1"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"backgroundColor": "#FF4D1C",
			"showSpinner": false,
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#FF4D1C"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#FF4D1C"
	},
	"ios": {
		"contentInset": "automatic",
		"backgroundColor": "#FF4D1C",
		"preferredContentMode": "mobile"
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"CAPCameraPlugin",
		"GeolocationPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"PushNotificationsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
