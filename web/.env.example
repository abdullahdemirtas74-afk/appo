# AppO — variables d'environnement
# Copier vers .env.local pour le dev

# Obligatoire en production (HMAC sessions). Min. 32 caractères aléatoires.
APPO_SECRET=change-me-to-a-long-random-string

# Persistance durable (Railway) : monter un volume sur /data
# DATA_DIR=/data

# URL publique (liens dans les e-mails)
# APPO_PUBLIC_URL=https://appo-production-10fb.up.railway.app

# --- E-mails Pros (activer quand le compte mail est ouvert) ---
# Plafond applicatif : 100 e-mails / jour vers les pros (modifiable en admin)
# APPO_MAIL_ENABLED=true
# APPO_MAIL_FROM=AppO <noreply@votredomaine.fr>
# APPO_RESEND_API_KEY=re_xxxxxxxx

# NODE_ENV=production est défini automatiquement par Next/Railway
