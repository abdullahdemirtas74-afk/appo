# AppO — variables d'environnement
# Copier vers .env.local pour le dev

# Obligatoire en production (HMAC sessions). Min. 32 caractères aléatoires.
APPO_SECRET=change-me-to-a-long-random-string

# Persistance durable (Railway) : monter un volume sur /data
# DATA_DIR=/data

# URL publique (liens dans les e-mails)
# APPO_PUBLIC_URL=https://appo-ad.com

# --- Stripe (paiements live) ---
# STRIPE_SECRET_KEY=sk_live_...   # jamais committer
# STRIPE_MODE=live
# STRIPE_WEBHOOK_SECRET=whsec_...  # Dashboard Stripe → Webhooks
# STRIPE_PUBLISHABLE_KEY=pk_live_...  # optionnel (Checkout hébergé n’en a pas besoin)

# Mode démo UI (comptes démo, reset, paiement simulé). En prod : laisser false / absent.
# NEXT_PUBLIC_APPO_DEMO_UI=false
# APPO_DEMO_UI=false

# --- E-mails (activer quand le compte mail est ouvert) ---
# Plafond applicatif : 100 e-mails / jour vers les pros (modifiable en admin)
# APPO_MAIL_ENABLED=true
# APPO_MAIL_FROM=AppO <contact@appo-ad.com>
# APPO_MAIL_REPLY_TO=contact@appo-ad.com
#
# Option A — Gmail / Google Workspace (recommandé pour contact@appo-ad.com)
# Créer un mot de passe d’application : https://myaccount.google.com/apppasswords
# APPO_SMTP_HOST=smtp.gmail.com
# APPO_SMTP_PORT=465
# APPO_SMTP_USER=contact@appo-ad.com
# APPO_SMTP_PASS=xxxx xxxx xxxx xxxx
#
# Option B — Resend (domaine appo-ad.com vérifié)
# APPO_RESEND_API_KEY=re_xxxxxxxx

# NODE_ENV=production est défini automatiquement par Next/Railway
